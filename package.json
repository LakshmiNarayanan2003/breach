{
  "name": "breach",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A free 3D arena shooter with landmark arenas, tactical enemies, dynamic music, and local co-op.",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "audio:generate": "python3 scripts/generate_audio.py",
    "format": "prettier --write src tests docs *.ts *.js *.json *.md index.html .github/workflows/*.yml"
  },
  "dependencies": {
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.10.0",
    "@types/three": "^0.180.0",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.2.0",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
